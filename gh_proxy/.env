# GitHub Proxy Service Configuration

# Authentication API Configuration
AUTH_API_URL=http://auth-api:9000
AUTH_API_ENABLED=false
AUTH_API_TIMEOUT=30.0

# GitHub Configuration
# GITHUB_TOKEN=
GITHUB_USER=filxxip
GITHUB_REPO=filxxip/remote-garden-ESP

# GitHub Container Registry
GHCR_REGISTRY=https://ghcr.io
GHCR_TOKEN_SERVICE=ghcr.io

# GitHub API Configuration
GITHUB_API_VERSION=2022-11-28
GITHUB_API_BASE_URL=https://api.github.com

# HTTP Client Configuration
HTTP_TIMEOUT=60.0
HTTP_FOLLOW_REDIRECTS=true

# Firmware Asset Configuration
FIRMWARE_ASSET_EXTENSIONS=.tar.gz,.zip,.bin,.gz

# Authentication Configuration
BASIC_AUTH_REALM=Docker Registry
DOCKER_API_VERSION=registry/2.0

# Fallback User Configuration (when auth is disabled)
FALLBACK_USER_ID=dev-user
FALLBACK_USER_IS_ADMIN=true