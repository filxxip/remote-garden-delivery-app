# SERVER_HOSTNAME=localhost

# Certificate Configuration
CERT_VALIDITY_DAYS=365
CERT_KEY_SIZE=2048
CERT_RENEWAL_THRESHOLD_DAYS=30

# Certificate Subject Components
CERT_COUNTRY=PL
CERT_STATE=Mazovia
CERT_CITY=Warsaw
CERT_ORGANIZATION=Dev

# Certificate Paths
CERT_DIR=/etc/nginx/certs
CERT_FILE_NAME=localhost.crt
KEY_FILE_NAME=localhost.key

# File Permissions
CERT_FILE_PERMISSIONS=644
KEY_FILE_PERMISSIONS=600

# Nginx Configuration
NGINX_CONFIG_TEST=true
NGINX_DAEMON_MODE=off
