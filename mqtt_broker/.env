TZ=Europe/Warsaw

# Certificate validity periods (in days)
CA_VALIDITY_DAYS=3650
SERVER_CERT_VALIDITY_DAYS=365
CLIENT_CERT_VALIDITY_DAYS=365

# Key sizes (in bits)
CA_KEY_SIZE=4096
SERVER_KEY_SIZE=4096
CLIENT_KEY_SIZE=2048

# Certificate subject components
CERT_COUNTRY=PL
CERT_STATE=LowerSilesia
CERT_CITY=Wroclaw
CERT_ORGANIZATION=PWR
CERT_ORG_UNIT=IT

# Server identification
SERVER_NAME=mqtt-broker

# variable moved to global env
# SERVER_HOSTNAME=vps-2505986b.vps.ovh.net
# SERVER_IP=51.38.113.60

# Additional SANs (Subject Alternative Names)
# Format: comma-separated list like "DNS:example.com,IP:10.0.0.1"
ADDITIONAL_SANS=

# Directory structure
BASE_DIR=.
CERTS_DIR=certs
PRIVATE_DIR=private
MOSQUITTO_DIR=mosquitto

# Mosquitto subdirectories
MOSQUITTO_CERTS_DIR=mosquitto/certs
MOSQUITTO_DATA_DIR=mosquitto/data
MOSQUITTO_LOG_DIR=mosquitto/log

# File permissions
PRIVATE_KEY_PERMS=640
PUBLIC_CERT_PERMS=644
DIR_PERMS=770

# Mosquitto user/group
MOSQUITTO_UID=1883
MOSQUITTO_GID=1883